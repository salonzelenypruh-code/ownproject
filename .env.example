# ── Databáze ─────────────────────────────────────────────
# Lokálně stačí soubor (výchozí file:local.db). Na produkci Turso (free):
#   turso db create kosmetika-zeleny-pruh
#   turso db show kosmetika-zeleny-pruh --url
#   turso db tokens create kosmetika-zeleny-pruh
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Přihlášení do adminu ─────────────────────────────────
# Vygenerovat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ADMIN_EMAIL=galinajork@gmail.com
ADMIN_PASSWORD=

# ── Fotky (Vercel Blob, free) ────────────────────────────
# Bez tokenu se fotky ukládají lokálně do public/uploads (jen pro vývoj).
BLOB_READ_WRITE_TOKEN=

# ── E-maily (Resend, free 100/den) ───────────────────────
# Bez klíče se e-maily jen vypíšou do konzole.
RESEND_API_KEY=
MAIL_FROM="Kosmetika na Zeleném pruhu <web@vase-domena.cz>"
MAIL_TO=galinajork@gmail.com

NEXT_PUBLIC_SITE_URL=http://localhost:8091
